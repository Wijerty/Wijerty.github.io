# Netlify: не давать браузеру кэшировать содержимое квеста.
# Тексты заданий можно дописывать после того, как QR-коды напечатаны,
# и телефон подтянет свежую версию, а не сохранённую с прошлого раза.
/*
  Cache-Control: no-cache

# Картинки можно кэшировать — они не меняются
/assets/img/*
  Cache-Control: public, max-age=86400
